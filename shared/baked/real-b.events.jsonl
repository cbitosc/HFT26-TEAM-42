{"ts": 1793395751442, "run_id": "real-b", "agent_id": "agentB", "type": "diff.ready", "data": {"from": "V1", "to": "V3", "unified_diff": "--- V1\n+++ V3\n@@ -1,5 +1,4 @@\n import time\n-import heapq\n from collections import OrderedDict\n \n class TTLCache:\n@@ -13,16 +12,17 @@\n         self.ttl = ttl\n         self.clock = clock\n         self.cache = OrderedDict()\n-        self.expiry_heap = []\n-        self.live_count = 0\n \n     def _remove_expired(self):\n         current_time = self.clock()\n-        while self.expiry_heap and self.expiry_heap[0][0] <= current_time:\n-            expiry, key = heapq.heappop(self.expiry_heap)\n-            if key in self.cache and self.cache[key][1] <= current_time:\n-                del self.cache[key]\n-                self.live_count -= 1\n+        to_remove = []\n+        for key, (value, expiry) in self.cache.items():\n+            if expiry <= current_time:\n+                to_remove.append(key)\n+            else:\n+                break\n+        for key in to_remove:\n+            del self.cache[key]\n \n     def put(self, key, value):\n         if self.capacity == 0:\n@@ -33,18 +33,13 @@\n         current_time = self.clock()\n         if key in self.cache:\n             del self.cache[key]\n-            self.live_count -= 1\n         \n         if len(self.cache) >= self.capacity:\n-            _, oldest_key = self.expiry_heap[0]\n+            oldest_key = next(iter(self.cache))\n             del self.cache[oldest_key]\n-            heapq.heappop(self.expiry_heap)\n-            self.live_count -= 1\n         \n         expiry = current_time + self.ttl\n         self.cache[key] = (value, expiry)\n-        heapq.heappush(self.expiry_heap, (expiry, key))\n-        self.live_count += 1\n \n     def get(self, key, default=None):\n         self._remove_expired()\n@@ -60,4 +55,4 @@\n \n     def __len__(self):\n         self._remove_expired()\n-        return self.live_count\n+        return len(self.cache)\n", "changelog": ["Replaced heap-based eviction with `OrderedDict` for maintaining insertion order.", "Used `next(iter(self.cache))` to evict the oldest inserted item when at capacity.", "Removed `live_count` and used `len(self.cache)` to determine the number of live items.", "Updated `_remove_expired` to check current expiry times directly in the cache.", "Modified `put` to only evict for new keys after removing expired items.", "Simplified `__len__` to return the length of `self.cache` directly."]}}
