{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AutoEvolve memory entry v1",
  "type": "object",
  "required": [
    "schema", "agent_id", "agent_address", "task_signature", "kind", "from_version", "to_version",
    "hypothesis", "failure_pattern", "changelog", "diff", "critique", "scores",
    "score_hash_old", "score_hash_new", "weights_version", "system_prompt_hash", "models",
    "harness", "embedding", "supersedes", "parent_cid", "created_at"
  ],
  "not": { "required": ["entry_id"] },
  "properties": {
    "schema": { "const": "autoevolve.memory.v1" },
    "agent_address": { "type": "string", "pattern": "^0x[0-9a-fA-F]{40}$" },
    "kind": { "enum": ["improvement", "regression"] },
    "changelog": { "type": "array", "items": { "type": "string" } },
    "scores": {
      "type": "object",
      "required": ["old", "new"],
      "properties": {
        "old": { "$ref": "#/$defs/score_vector" },
        "new": { "$ref": "#/$defs/score_vector" }
      }
    },
    "score_hash_old": { "$ref": "#/$defs/hash32" },
    "score_hash_new": { "$ref": "#/$defs/hash32" },
    "system_prompt_hash": { "$ref": "#/$defs/hash32" },
    "placeholder": { "type": "boolean" },
    "created_at": { "type": "integer" }
  },
  "$defs": {
    "hash32": { "type": "string", "pattern": "^0x[0-9a-fA-F]{64}$" },
    "score_vector": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": { "type": "integer", "minimum": 0, "maximum": 100 }
    }
  }
}
